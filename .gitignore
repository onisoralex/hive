# Projects have their own git repositories — ignore all except template and platform
projects/*
!projects/template/
!projects/platform/

# Archived workspace output
archive/

# Worker output — ignore content but keep directory structure via .gitkeep
workspace/researcher/*
!workspace/researcher/.gitkeep
workspace/developer/*
!workspace/developer/.gitkeep
workspace/tech-specialist/*
!workspace/tech-specialist/.gitkeep
workspace/finance-specialist/*
!workspace/finance-specialist/.gitkeep
workspace/marketer/*
!workspace/marketer/.gitkeep
workspace/writer/*
!workspace/writer/.gitkeep
workspace/data-analyst/*
!workspace/data-analyst/.gitkeep
